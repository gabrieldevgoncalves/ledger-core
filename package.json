{
  "name": "ledger-core",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter api run start:dev",
    "dev:dashboard": "pnpm --filter dashboard run dev",
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:dashboard\"",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "pnpm --filter api run prisma:migrate",
    "db:studio": "pnpm --filter api run prisma:studio",
    "test": "pnpm --filter api run test",
    "test:e2e": "pnpm --filter api run test:e2e"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
